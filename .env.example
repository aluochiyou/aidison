# PostgreSQL is the only canonical business/runtime store.
DATABASE_URL=postgresql+asyncpg://aidison:aidison_dev@localhost:5432/aidison

# Available in the user's system environment; do not copy the real value here.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
AIDISON_MODEL_PROVIDER=bailian

# Research requires an explicit search provider key and fails closed without it.
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp
TAVILY_SEARCH_DEPTH=advanced
TAVILY_SEARCH_TIMEOUT_SECONDS=10

# GitHub is exposed only to the worker through the pinned official read-only MCP binary.
GITHUB_API_KEY=
GITHUB_MCP_BINARY_PATH=/server/github-mcp-server

# Optional V0 adapters. Missing keys must fail closed or use the Noop sink.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
LANGSMITH_API_KEY=

AIDISON_ENV=development
AIDISON_API_PORT=8000
AIDISON_WEB_PORT=3000
AIDISON_POSTGRES_PORT=5432
AIDISON_ARTIFACT_ROOT=artifacts/data
AIDISON_WORKER_CONCURRENCY=3
AIDISON_WORKER_LEASE_SECONDS=60
AIDISON_WORKER_POLL_SECONDS=0.5
