{
	auto_https off
	admin off
}

:8080 {
	@edge_health path /edge-health
	@business not path /edge-health

	basic_auth @business {
		{$AIDISON_ADMIN_USER} {$AIDISON_ADMIN_PASSWORD_HASH}
	}

	handle @edge_health {
		respond "ok" 200
	}

	# Keep API commands and SSE on one proxy hop. Routing these requests through
	# Next.js first added buffering/cancellation semantics and could leave the
	# browser with a Cloudflare 524 even after FastAPI committed the command.
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		header {
			-Server
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "same-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			Cross-Origin-Opener-Policy "same-origin"
		}

		reverse_proxy web:3000 {
			flush_interval -1
		}
	}
}
