# Secrets and deployment-specific connection values belong here.
DATABASE_URL=postgresql+asyncpg://aidison:aidison_dev@localhost:5432/aidison
# Must be a disposable database; integration tests refuse the runtime `aidison` target.
TEST_DATABASE_URL=postgresql+asyncpg://aidison:your-url-encoded-password@localhost:5432/aidison_test

# Model and research credentials are intentionally kept out of config.yaml.
# DEEPSEEK_API_KEY targets the official DeepSeek OpenAI-compatible endpoint;
# the legacy DASHSCOPE_API_KEY name is still accepted as a deprecated alias.
DEEPSEEK_API_KEY=
# OpenCode Go MiMo verification/replication profile. Existing Opencode_API_KEY
# is accepted for backwards compatibility, but new environments use uppercase.
OPENCODE_API_KEY=
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
# Deep research may retain up to 8 source snapshots (4 bounded queries × 2 sources).
# Lower this only when deliberately trading coverage for provider cost.
TAVILY_MAX_RESULTS=8

# GitHub is exposed only to the worker through the pinned official read-only MCP binary.
GITHUB_API_KEY=
GITHUB_MCP_BINARY_PATH=/server/github-mcp-server

# Optional observability adapter. Missing keys must fail closed or use the Noop sink.
LANGSMITH_API_KEY=
# Evaluation harness reporter: strictly opt-in and fail-closed. The reporter is
# only constructed when AIDISON_EVAL_LANGSMITH_ENABLED=1 AND LANGSMITH_API_KEY is
# set; the SDK is imported lazily inside report() and never at import time.
AIDISON_EVAL_LANGSMITH_ENABLED=0
AIDISON_EVAL_LANGSMITH_PROJECT=aidison-evaluation

AIDISON_ENV=development
AIDISON_API_PORT=8000
AIDISON_WEB_PORT=3000
AIDISON_POSTGRES_PORT=5432
AIDISON_ARTIFACT_ROOT=artifacts/data
AIDISON_WORKER_CONCURRENCY=3
AIDISON_WORKER_LEASE_SECONDS=60
AIDISON_WORKER_POLL_SECONDS=0.5
