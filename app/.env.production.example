# Copy to .env.production. Never commit the populated file.
# Use URL-safe random text for POSTGRES_PASSWORD because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-at-least-32-random-url-safe-characters

# Single-owner application login. The password is verified by FastAPI and the
# browser receives only a signed HttpOnly + Secure + SameSite=Strict cookie.
AIDISON_ADMIN_USER=aidison
# Generate with:
# docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext "YOUR_PASSWORD"
# In PowerShell, quote the resulting bcrypt hash when writing this file.
AIDISON_ADMIN_PASSWORD_HASH='$2a$14$replace_with_caddy_bcrypt_hash'
AIDISON_SESSION_SECRET=replace-with-at-least-43-random-url-safe-characters
AIDISON_PUBLIC_ORIGIN=https://aidison.xyz
AIDISON_SESSION_TTL_SECONDS=28800

# Create a remotely managed Cloudflare Tunnel and route the public hostname to
# http://gateway:8080, then paste only its connector token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Image/release identity shown in runtime traces.
AIDISON_RELEASE=production-local
AIDISON_EDGE_PORT=8080

DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
DASHSCOPE_API_KEY=
AIDISON_MODULE_VISUAL_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
AIDISON_MODULE_VISUAL_MODEL=qwen3.7-flash
AIDISON_MODULE_VISUAL_TIMEOUT_SECONDS=90
# Select one bounded source-discovery provider. With `firecrawl`, every
# admitted webpage still passes Aidison's public-HTTPS and evidence gates.
AIDISON_WEB_SEARCH_PROVIDER=tavily
FIRECRAWL_MAX_RESULTS=8
FIRECRAWL_MAX_QUERIES=4
AIDISON_GITHUB_API_TOKEN=
AIDISON_GITHUB_SOURCE_TARGETS=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=

# Langfuse is opt-in and exports scalar trace metadata only.
# Standard LANGFUSE_* variables are also accepted for compatibility with the
# official SDK. Set either naming scheme, never both with different values.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
AIDISON_RUNTIME_LANGFUSE_ENABLED=0
AIDISON_RUNTIME_LANGFUSE_PROJECT=aidison-runtime
AIDISON_RUNTIME_LANGFUSE_PUBLIC_KEY=
AIDISON_RUNTIME_LANGFUSE_SECRET_KEY=
AIDISON_RUNTIME_LANGFUSE_BASE_URL=https://cloud.langfuse.com
AIDISON_RUNTIME_LANGFUSE_ENVIRONMENT=production
AIDISON_RUNTIME_LANGFUSE_RELEASE=

AIDISON_WORKER_CONCURRENCY=3
AIDISON_MODEL_MAX_CONCURRENCY=2
AIDISON_MODEL_CIRCUIT_FAILURE_THRESHOLD=5
AIDISON_MODEL_CIRCUIT_WINDOW_SECONDS=60
AIDISON_MODEL_CIRCUIT_OPEN_SECONDS=30
